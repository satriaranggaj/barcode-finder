# These are environment variables. PowerShell examples are in README.md.
SIGLIP_MODEL=google/siglip2-base-patch16-256
DINO_MODEL=facebook/dinov2-small
SIGLIP_REVISION=main
DINO_REVISION=main
DEVICE=auto
SIGLIP_WEIGHT=0.35
DINO_WEIGHT=0.65
LOCAL_WEIGHT=0.25
FAISS_INDEX_PATH=indexes
DEFAULT_TOP_K=5
CANDIDATES=50
PREPROCESSING_MODE=object
BATCH_SIZE=2
CPU_THREADS=4
MAX_BYTES=20971520
MAX_PIXELS=40000000
MAX_SIDE=1024
HIGH_SCORE=0.85
HIGH_GAP=0.08
MEDIUM_SCORE=0.70
ENABLE_LEGACY_EMBED=true
