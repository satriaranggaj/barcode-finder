# These are environment variables. PowerShell examples are in README.md.
SIGLIP_MODEL=google/siglip2-base-patch16-256
DINO_MODEL=facebook/dinov2-small
SIGLIP_REVISION=main
DINO_REVISION=main
DEVICE=auto
SIGLIP_WEIGHT=0.35
DINO_WEIGHT=0.65
LOCAL_WEIGHT=0.5
# Object-centric fusion: weight of global query-vs-global reference in the visual
# score when both sides have an object representation (0 = object pair only).
# Mixed pairs (object vs full) always fall back to the global pair regardless.
GLOBAL_WEIGHT=0.0
# Reciprocal-rank fusion bias for the per-model shortlist union (0 = classic 1/(rank+1)).
RANK_BIAS=60.0
# Weight of the object-index shortlist vs the global-index shortlist when the
# query carries an object (1 = object index only; global index still serves
# queries without an object).
OBJECT_INDEX_WEIGHT=0.8
# Anti-count-bias: maximum shortlist candidates allowed per SKU.
CANDIDATES_PER_SKU=3
# DINO patch reranking (shortlist-only). PATCH_WEIGHT=0 disables patches entirely.
PATCH_WEIGHT=0.0
# Robust symmetric correspondence aggregation: top_k | median | trimmed_mean | mean.
PATCH_AGGREGATION=top_k
PATCH_TOP_K=16
PATCH_TRIM=0.1
MAX_PATCHES=64
FAISS_INDEX_PATH=indexes
DEFAULT_TOP_K=5
CANDIDATES=50
PREPROCESSING_MODE=object
BATCH_SIZE=2
CPU_THREADS=4
MAX_BYTES=20971520
MAX_PIXELS=40000000
MAX_SIDE=1024
# Decode memory budget (MB) bounding peak native decode/re-encode RAM.
PROCESSING_MEMORY_MB=256
# WebP variant qualities (75..95) and derivative long sides in pixels.
MASTER_QUALITY=88
CATALOG_QUALITY=83
THUMBNAIL_QUALITY=78
CATALOG_SIDE=1600
THUMBNAIL_SIDE=400
# Foreground selection padding around the detected box (0..0.25).
SELECTION_PADDING=0.08
# Accepted covered-area window for object proposals (0 < min < max <= 1).
SELECTION_MIN_AREA=0.02
SELECTION_MAX_AREA=0.92
# Secondary evidence stays visual-majority: SECONDARY_WEIGHT must be < 0.5.
SECONDARY_WEIGHT=0.0
DESCRIPTION_TEXT_WEIGHT=0.0
# Frozen relevance policy file from calibrate freeze; empty disables gating.
RELEVANCE_POLICY=
HIGH_SCORE=0.85
HIGH_GAP=0.08
# Display-only near-tie margin for the ambiguity flag; not a calibrated gate.
AMBIGUITY_MARGIN=0.05
MEDIUM_SCORE=0.70
ENABLE_LEGACY_EMBED=true
# Optional CPU OCR (Tesseract executable) for markings like PH2/10MM/1.5".
# Disabled by default; secondary evidence only, never required for search.
OCR_ENABLED=false
OCR_BINARY=tesseract
OCR_MIN_CONFIDENCE=80
