APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Database queue reservation window. Must exceed the RebuildVisualIndex job
# timeout (7200s) with margin, otherwise a still-running CPU rebuild is
# considered available and picked up twice. Lock + revision checks make a
# duplicate harmless, but a correct reservation avoids the wasted work.
DB_QUEUE_RETRY_AFTER=7500

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Object storage (S3-compatible: Cloudflare R2, MinIO, Backblaze B2, ...).
# Leave empty for development; production fills these from the environment.
#
# Cloudflare R2 example (no real credentials are ever stored here):
#   AWS_ACCESS_KEY_ID=<R2 access key id>
#   AWS_SECRET_ACCESS_KEY=<R2 secret access key>
#   AWS_DEFAULT_REGION=auto
#   AWS_BUCKET=<bucket name>
#   AWS_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   AWS_USE_PATH_STYLE_ENDPOINT=true
#   AWS_URL=https://<public-bucket-url>   # used for signed temporary URLs
#   PRODUCT_IMAGE_DISK=s3
#   TRAINING_IMAGE_DISK=s3
#
# Generic S3 providers: set AWS_ENDPOINT to the provider endpoint and
# AWS_USE_PATH_STYLE_ENDPOINT=true when the provider requires path-style URLs.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_ENDPOINT=

VITE_APP_NAME="${APP_NAME}"

# Primary visual search uses FastAPI /search (FAISS + rerank).
# Set legacy only for environments without a running ai-service (pgvector cosine).
SKU_SEARCH_DRIVER=faiss
# Bounded single-attempt HTTP calls; inference failures surface as a friendly
# error page instead of hanging. Timeouts are additionally capped by the
# remaining PHP max_execution_time, which is never raised for AI calls.
# No retry: each attempt costs a full inference pass on the AI host.
SKU_SEARCH_CONNECT_TIMEOUT=3
SKU_SEARCH_READ_TIMEOUT=20
# FastAPI base URL and legacy pgvector fallback threshold (driver=legacy only).
AI_SERVICE_URL=http://127.0.0.1:8001
AI_SEARCH_MIN_SIMILARITY=0.72
# Local tooling paths (Windows venv / served FAISS generations).
# Leave commented for defaults (ai-service venv python, ai-service/indexes).
# AI_PYTHON_BINARY=
# FAISS_INDEX_PATH=
# Retention for published FAISS generations and stale build artifacts.
# keep<=0 keeps every generation; stale_hours/days<=0 disable that pruner.
INDEX_GENERATIONS_KEEP=3
INDEX_GENERATION_GRACE_SECONDS=3600
INDEX_BUILD_STALE_HOURS=24
INDEX_EXPORT_RETENTION_DAYS=3
SEARCH_FEEDBACK_ENABLED=false
# Minimum reference fitness for confirmed_search images (heuristic flags, not probabilities).
# Lenient by design: slightly noisy store photos must still pass.
REFERENCE_MIN_BLUR=60
REFERENCE_MIN_SIDE=128
REFERENCE_MIN_CROP_PIXELS=16384
REFERENCE_MIN_STD=8
REFERENCE_MAX_DHASH_DISTANCE=4
# Catalog images (master/catalog/thumbnail): 'public' in development, 's3' in production.
PRODUCT_IMAGE_DISK=public
# Verified search references / future training images: 'local' in development, 's3' in production.
TRAINING_IMAGE_DISK=local
# Transient query photos always stay on the app server and are pruned within minutes.
QUERY_IMAGE_DISK=local
PRODUCT_IMAGE_QUALITY=88
PRODUCT_CATALOG_QUALITY=83
PRODUCT_THUMBNAIL_QUALITY=78
PRODUCT_CATALOG_SIDE=1600
PRODUCT_THUMBNAIL_SIDE=400
# Set AI_PYTHON_BINARY / FAISS_INDEX_PATH when using non-default local paths.
# DB, AI models/cache, FAISS and temporary processing files remain on the VPS/local filesystem.
